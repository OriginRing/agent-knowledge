{
  "name": "view",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "npm run hooks:install",
    "hooks:install": "git -C .. config core.hooksPath .githooks",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run format:check"
  },
  "dependencies": {
    "@antv/gpt-vis": "^1.0.0",
    "@open-file-viewer/core": "^0.1.42",
    "@open-file-viewer/vue": "^0.1.42",
    "@zumer/snapdom": "^1.9.14",
    "ant-design-vue": "^4.2.6",
    "ant-design-x-vue": "^1.6.0",
    "axios": "^1.16.1",
    "dayjs": "^1.11.21",
    "file-saver": "^2.0.5",
    "github-markdown-css": "^5.9.0",
    "html-docx-js-typescript": "^0.1.5",
    "lodash-es": "^4.18.1",
    "markdown-it": "^14.1.1",
    "pdfjs-dist": "^5.6.205",
    "pinia": "^3.0.4",
    "prismjs": "^1.30.0",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.11.1",
    "less": "^4.6.4",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.12",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.2.8"
  }
}
